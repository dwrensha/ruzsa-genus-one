{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruzsa-genus-one",
  "account_id": "641ee17fdc075e1c2f3b2cfc7ffdea81",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "routes": [{ "pattern": "ruzsa-genus-one.icarm.cloud", "custom_domain": true }],
  "assets": {
    "directory": "./public"
  },
  // OAuth secrets are set via:
  //   wrangler secret put GITHUB_CLIENT_ID
  //   wrangler secret put GITHUB_CLIENT_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruzsa-genus-one",
      "database_id": "4a58adce-c793-4b1f-9f73-5b8a9853090b",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "fb174c11f72841c3b525995541d53cf0"
    }
  ],
  "observability": {
    "enabled": true
  }
}
