{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruzsa-genus-one",
  "account_id": "641ee17fdc075e1c2f3b2cfc7ffdea81",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "routes": [{ "pattern": "ruzsa-genus-one.icarm.cloud", "custom_domain": true }],
  "assets": {
    "directory": "./public"
  },
  // OAuth secrets are set via:
  //   wrangler secret put GITHUB_CLIENT_ID
  //   wrangler secret put GITHUB_CLIENT_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruzsa-genus-one",
      "database_id": "4a58adce-c793-4b1f-9f73-5b8a9853090b",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "fb174c11f72841c3b525995541d53cf0"
    },
    {
      // OAuth grants/tokens for the MCP endpoint (@cloudflare/workers-oauth-provider).
      "binding": "OAUTH_KV",
      "id": "f0772db84c0c470aa2eee6622fb57f81"
    }
  ],
  // Required by clientIdMetadataDocumentEnabled (CIMD client registration):
  // makes outbound fetch refuse private-network destinations (SSRF guard).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      // Unique integer namespace for per-account submission limits.
      // (677255 is taken by elliptic-rank on this account.)
      "namespace_id": "677256",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
